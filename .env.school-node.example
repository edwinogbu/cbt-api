# School CBT Node configuration template.
#
# Copy this file to .env.school-node and fill in real values before running
# docker-compose.school-node.yml. Never commit the filled-in .env.school-node
# file - it will contain this node's real database password and JWT
# secrets.
#
# CRITICAL: JWT_SECRET and JWT_REFRESH_SECRET must be a DIFFERENT random
# value on every single school node. If two nodes ever shared the same
# secret, a token forged for (or leaked from) one school's node would
# authenticate against every other school's node too. The backend now
# refuses to start in production without these set to something other
# than the placeholder default (see config/config.go), but that only
# catches "forgot to set it" - it can't catch "copy-pasted the same
# value onto every node," so generate a fresh one per node:
#
#   scripts/generate-school-node-secrets.sh
#
# and paste its output below.

DB_USER=cbt_node
DB_PASSWORD=CHANGE_ME_generate_a_real_password
DB_NAME=cbt_db

JWT_SECRET=CHANGE_ME_run_scripts_generate-school-node-secrets.sh
JWT_REFRESH_SECRET=CHANGE_ME_run_scripts_generate-school-node-secrets.sh

# First admin account for this node, created automatically on first boot
# (AUTO_MIGRATE=true + these two set). Leave blank to skip and create the
# first admin manually instead.
ADMIN_EMAIL=admin@yourschool.example
ADMIN_PASSWORD=CHANGE_ME_a_real_password

# The port this node's API is reachable at on the school LAN.
SCHOOL_NODE_PORT=8080
